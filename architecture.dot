digraph TixoraArchitecture {
    rankdir=TB;
    splines=ortho;
    nodesep=1.2;
    ranksep=1.5;
    fontname="Arial";
    fontsize=12;
    
    // Client Layer
    subgraph cluster_client {
        label="Client Layer";
        style=filled;
        color="#e1f5ff";
        fillcolor="#e1f5ff";
        web [label="Web Frontend\nPort: 3000\nReact + Vite", shape=box3d, style=filled, fillcolor="#4fc3f7", fontcolor="white"];
    }
    
    // API Gateway Layer
    subgraph cluster_gateway {
        label="API Gateway Layer";
        style=filled;
        color="#fff4e1";
        fillcolor="#fff4e1";
        gateway [label="API Gateway\nPort: 5000\nExpress + JWT", shape=component, style=filled, fillcolor="#ffb74d", fontcolor="white"];
    }
    
    // Microservices Layer
    subgraph cluster_services {
        label="Microservices Layer";
        style=filled;
        color="#e8f5e9";
        fillcolor="#e8f5e9";
        
        auth [label="Auth Service\nPort: 5001\nNode.js", shape=folder, style=filled, fillcolor="#66bb6a", fontcolor="white"];
        event [label="Event Service\nPort: 5002\nNode.js", shape=folder, style=filled, fillcolor="#66bb6a", fontcolor="white"];
        booking [label="Booking Service\nPort: 5003\nNode.js", shape=folder, style=filled, fillcolor="#66bb6a", fontcolor="white"];
        notification [label="Notification Service\nPort: 5004\nNode.js", shape=folder, style=filled, fillcolor="#66bb6a", fontcolor="white"];
        payment [label="Payment Service\nPort: 5005\nNode.js", shape=folder, style=filled, fillcolor="#66bb6a", fontcolor="white"];
    }
    
    // Data Layer
    subgraph cluster_data {
        label="Data Layer";
        style=filled;
        color="#f3e5f5";
        fillcolor="#f3e5f5";
        
        auth_db [label="Auth DB\nMongoDB:27017\ntixora_auth", shape=cylinder, style=filled, fillcolor="#ab47bc", fontcolor="white"];
        event_db [label="Event DB\nMongoDB:27018\ntixora_events", shape=cylinder, style=filled, fillcolor="#ab47bc", fontcolor="white"];
        booking_db [label="Booking DB\nMongoDB:27019\ntixora_bookings", shape=cylinder, style=filled, fillcolor="#ab47bc", fontcolor="white"];
        payment_db [label="Payment DB\nMongoDB:27020\ntixora_payments", shape=cylinder, style=filled, fillcolor="#ab47bc", fontcolor="white"];
        redis [label="Redis Cache\nPort: 6379\nMessage Broker", shape=ellipse, style=filled, fillcolor="#ec407a", fontcolor="white"];
    }
    
    // Infrastructure
    subgraph cluster_infra {
        label="Infrastructure";
        style=dashed;
        color="#bdbdbd";
        
        network [label="tixora-network\nBridge Network", shape=box, style=filled, fillcolor="#9e9e9e", fontcolor="white"];
        volumes [label="Persistent Volumes\nDocker Volumes", shape=note, style=filled, fillcolor="#78909c", fontcolor="white"];
    }
    
    // Connections - Web to Gateway
    web -> gateway [label="HTTP/JSON", fontsize=10, color="#1976d2"];
    
    // Connections - Gateway to Services
    gateway -> auth [label="Route: /auth/*", fontsize=10, color="#388e3c"];
    gateway -> event [label="Route: /events/*", fontsize=10, color="#388e3c"];
    gateway -> booking [label="Route: /bookings/*", fontsize=10, color="#388e3c"];
    gateway -> notification [label="Route: /notifications/*", fontsize=10, color="#388e3c"];
    gateway -> payment [label="Route: /payments/*", fontsize=10, color="#388e3c"];
    
    // Connections - Services to Databases
    auth -> auth_db [label="MongoDB\nAuth", fontsize=9, color="#7b1fa2"];
    event -> event_db [label="MongoDB\nEvents", fontsize=9, color="#7b1fa2"];
    booking -> booking_db [label="MongoDB\nBookings", fontsize=9, color="#7b1fa2"];
    payment -> payment_db [label="MongoDB\nPayments", fontsize=9, color="#7b1fa2"];
    
    // Connections - Services to Redis
    auth -> redis [label="Cache\nPub/Sub", fontsize=9, color="#c2185b"];
    event -> redis [label="Cache\nPub/Sub", fontsize=9, color="#c2185b"];
    booking -> redis [label="Cache\nPub/Sub", fontsize=9, color="#c2185b"];
    notification -> redis [label="Pub/Sub\nQueue", fontsize=9, color="#c2185b"];
    payment -> redis [label="Cache\nPub/Sub", fontsize=9, color="#c2185b"];
    gateway -> redis [label="Cache\nSession", fontsize=9, color="#c2185b"];
    
    // Inter-service communication
    booking -> event [label="Event Details", fontsize=9, color="#f57c00", style=dashed];
    booking -> auth [label="User Validation", fontsize=9, color="#f57c00", style=dashed];
    booking -> notification [label="Booking Alerts", fontsize=9, color="#f57c00", style=dashed];
    auth -> notification [label="Auth Alerts", fontsize=9, color="#f57c00", style=dashed];
    
    // Infrastructure connections
    auth_db -> volumes [label="Data Persistence", fontsize=8, color="#546e7a", style=dotted];
    event_db -> volumes [label="Data Persistence", fontsize=8, color="#546e7a", style=dotted];
    booking_db -> volumes [label="Data Persistence", fontsize=8, color="#546e7a", style=dotted];
    payment_db -> volumes [label="Data Persistence", fontsize=8, color="#546e7a", style=dotted];
    redis -> volumes [label="Data Persistence", fontsize=8, color="#546e7a", style=dotted];
}
