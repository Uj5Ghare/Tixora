{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ObjectWrite",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:PutObjectAcl",
                "s3:PutObjectTagging",
                "s3:PutObjectVersionTagging",
                "s3:AbortMultipartUpload"
            ],
            "Resource": "arn:aws:s3:::tixora-apps-builds/*"
        },
        {
            "Sid": "ListBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:ListBucketMultipartUploads"
            ],
            "Resource": "arn:aws:s3:::tixora-apps-builds"
        }
    ]
}